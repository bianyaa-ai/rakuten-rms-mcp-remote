# Required for RMS tools
RMS_SERVICE_SECRET=your_service_secret
RMS_LICENSE_KEY=your_license_key
RMS_SHOP_ID=

# HTTP
PORT=8000
# Comma-separated hostnames (DNS rebinding protection).
# On Vercel, VERCEL_URL hosts are added automatically; still set production hostname if using a custom domain.
ALLOWED_HOSTS=localhost,127.0.0.1

# Auth (at least one)
# Shared passcode for Claude/ChatGPT OAuth authorize page (you choose this; not from Rakuten)
RMS_MCP_OAUTH_PASSCODE=change-me
# Optional static Bearer for clients that can set headers (Cursor remote)
RMS_MCP_API_KEY=
# Optional OAuth token persistence path (on Vercel defaults to /tmp if unset)
RMS_MCP_OAUTH_STORE_PATH=./data/oauth-store.json

# Contents / R-Cabinet and RMS write tools are available to authenticated clients by default.
# There is no global write-enable variable; each write tool is protected per operation
# (explicit confirmUpload/confirmCreate/confirmUpdate inputs, strict schemas, duplicate prevention, etc.).
