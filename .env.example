# Required for RMS tools
RMS_SERVICE_SECRET=your_service_secret
RMS_LICENSE_KEY=your_license_key
RMS_SHOP_ID=

# HTTP
PORT=8000
# Comma-separated hostnames when binding 0.0.0.0 (e.g. your.railway.app)
ALLOWED_HOSTS=localhost,127.0.0.1

# Auth (at least one)
# Shared passcode for Claude/ChatGPT OAuth authorize page
RMS_MCP_OAUTH_PASSCODE=change-me
# Optional static Bearer for clients that can set headers (Cursor remote)
RMS_MCP_API_KEY=
# Optional OAuth token persistence path
RMS_MCP_OAUTH_STORE_PATH=./data/oauth-store.json
